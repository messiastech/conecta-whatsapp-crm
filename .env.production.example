# ==============================================================================
# YESHUA CLOUD DEMO - VARIÁVEIS DE AMBIENTE DE PRODUÇÃO (.env.production)
# ==============================================================================

# 1. Configuração do Servidor e Modo de Execução
NODE_ENV=production
PORT=3000

# 2. Banco de Dados Isolado (Instância PostgreSQL Neon isolada para a Demo Yeshua)
DATABASE_URL="postgresql://yeshua_user:sua_senha_secreta@ep-yeshua-demo.sa-east-1.aws.neon.tech/yeshua_crm?sslmode=require"

# 3. Autenticação & Sessão (Better Auth - Mínimo 32 caracteres criptográficos)
BETTER_AUTH_SECRET="chave_secreta_better_auth_minimo_32_caracteres_aleatorios_yeshua_demo_prod"
BETTER_AUTH_URL="https://yeshua-ai-client-desk.onrender.com"

# 4. Criptografia em Repouso (Chave Mestra AES-256-GCM para tokens/chaves de tenants - Mínimo 32 caracteres)
ENCRYPTION_MASTER_KEY="chave_mestra_aes256_gcm_yeshua_32_bytes_segura_mega_core!!"

# 5. Perfil Vertical Contábil & Regras de Acesso
VERTICAL_PROFILE=ACCOUNTING
ALLOW_PUBLIC_SIGNUP=false

# 6. Identidade e Branding
BRAND_NAME="YESHUA AI CLIENT DESK"
BRAND_SUBTITLE="powered by MEGA CORE"

# 7. Operador Demonstração Yeshua (Credenciais Injetadas via Secrets na Nuvem)
YESHUA_DEMO_EMAIL="demo@yeshuacontabilidade.com.br"
YESHUA_DEMO_PASSWORD="DEFINA_UMA_SENHA_FORTE_AQUI_VIA_CLOUD_SECRET"

# 8. CORS & Domínios Autorizados
CORS_ORIGIN="https://yeshua-ai-client-desk.onrender.com,https://yeshua-ai-client-desk.fly.dev"

# 9. Provedores de Mensageria e IA
WHATSAPP_PROVIDER=mock
# META_GRAPH_API_URL="https://graph.facebook.com/v21.0"
# META_PHONE_NUMBER_ID=""
# META_ACCESS_TOKEN=""
# META_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN=""

# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
