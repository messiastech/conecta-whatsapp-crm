# ==========================================
# CONECTA WHATSAPP CRM - VARIÁVEIS DE AMBIENTE
# ==========================================

# Servidor e Porta
PORT=3000
NODE_ENV=development

# Banco de Dados Multi-Tenant (PostgreSQL gerenciado na nuvem: Supabase, Neon, RDS, etc.)
DATABASE_URL="postgresql://postgres:sua_senha@ep-xyz.us-east-2.aws.neon.tech/conecta_crm?sslmode=require"

# Autenticação & Sessão (Better Auth)
BETTER_AUTH_SECRET="chave_secreta_minimo_32_caracteres_aleatorios_12345"
BETTER_AUTH_URL="http://localhost:3000"

# Segurança & Criptografia (Chave mestra AES-256-GCM para tokens/secrets de tenants)
ENCRYPTION_MASTER_KEY="chave_mestra_aes_256_gcm_para_secrets_tenants_32_bytes!!"

# CORS & Domínios permitidos
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Provedor padrão de WhatsApp de Fallback ("mock" para sandbox local ou "meta" para WhatsApp Cloud API oficial)
WHATSAPP_PROVIDER=mock
META_GRAPH_API_URL="https://graph.facebook.com/v21.0"
META_WEBHOOK_VERIFY_TOKEN="conecta_webhook_token_secret_2026"

# Provedores Globais de IA (Opcional - Cada tenant pode configurar suas próprias chaves no painel)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ==========================================
# VERTICALIZADORES & DEMO (Yeshua Contabilidade / MEGA CORE)
# ==========================================
VERTICAL_PROFILE=ACCOUNTING
ALLOW_PUBLIC_SIGNUP=false
BRAND_NAME="YESHUA AI CLIENT DESK"
BRAND_SUBTITLE="powered by MEGA CORE"
YESHUA_DEMO_EMAIL="demo@yeshuacontabilidade.com.br"
YESHUA_DEMO_PASSWORD="Yeshua2026!Demo"

# ==========================================
# E-MAIL TRANSACIONAL & RECUPERAÇÃO DE SENHA (Resend)
# ==========================================
RESEND_API_KEY=""
AUTH_EMAIL_FROM="MEGA SI <acesso@megasi.com.br>"
RESEND_API_URL="https://api.resend.com/emails"
ENABLE_PASSWORD_RESET="" # "true" ou "false" (opcional para forçar habilitação/desabilitação)
