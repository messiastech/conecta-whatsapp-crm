# ==========================================
# CONECTA WHATSAPP CRM - VARIÁVEIS DE AMBIENTE
# ==========================================

# Servidor e Porta
PORT=3000
NODE_ENV=development

# Banco de Dados (SQLite em dev, PostgreSQL em produção)
DATABASE_URL="file:./dev.db"

# Provedor de WhatsApp ("mock" para sandbox local ou "meta" para WhatsApp Cloud API oficial)
WHATSAPP_PROVIDER=mock

# Configurações Oficiais da Meta (Necessárias apenas quando WHATSAPP_PROVIDER=meta)
META_GRAPH_API_URL="https://graph.facebook.com/v21.0"
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="conecta_webhook_token_secret_2026"

# Provedores de Inteligência Artificial
# Se nenhuma chave for informada, o sistema acionará automaticamente o RuleBasedFallbackProvider (100% offline)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
